{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/__tests__/**",
    "!src/types/**"
  ],
  "mutator": {
    "excludedMutations": []
  },
  "jest": {
    "configFile": "jest.stryker.config.js",
    "enableFindRelatedTests": false
  },
  "ignorePatterns": [
    "example",
    "lib",
    "docs",
    "reports",
    ".yarn",
    ".githooks",
    "coverage",
    "*.log"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "reporters": [
    "progress",
    "json",
    "event-recorder"
  ],
  "eventReporter": {
    "baseDir": "reports/mutation/events"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/full.json"
  },
  "concurrency": 12,
  "timeoutMS": 60000,
  "logLevel": "error",
  "incrementalFile": "reports/mutation/incremental.json"
}
