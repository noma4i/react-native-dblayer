{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "mutate": [
    "src/core/writePolicies.ts",
    "src/core/invariants.ts",
    "src/core/serialize.ts",
    "src/core/compileDbWhere.ts",
    "src/core/relations.ts",
    "src/core/schemaManifest.ts",
    "src/core/subscriptionLifecycle.ts",
    "src/core/planes/operationState.ts",
    "src/core/apply/transaction.ts",
    "src/core/apply/journal.ts",
    "src/utils/runtimePrimitives.ts",
    "src/utils/modelMaintenance.ts",
    "src/utils/optimisticReconcile.ts"
  ],
  "mutator": {
    "excludedMutations": [
      "ArithmeticOperator",
      "ArrayDeclaration",
      "AssignmentOperator",
      "BlockStatement",
      "BooleanLiteral",
      "ObjectLiteral",
      "Regex",
      "StringLiteral",
      "UnaryOperator",
      "UpdateOperator"
    ]
  },
  "jest": {
    "configFile": "jest.stryker.config.js",
    "enableFindRelatedTests": false
  },
  "ignorePatterns": ["example", "lib", "docs", "reports", ".yarn", ".githooks", "coverage", "*.log"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/full.json"
  },
  "concurrency": 12,
  "timeoutMS": 60000,
  "logLevel": "info"
}
