#!/bin/sh
set -e

echo "pre-commit: typecheck"
npx tsc --noEmit

echo "pre-commit: lint"
yarn lint

echo "pre-commit: jsdoc"
node scripts/check-jsdoc.mjs

echo "pre-commit: spec markers"
node scripts/check-spec-markers.mjs
echo "pre-commit: silent drops"
node scripts/check-silent-drops.mjs

echo "pre-commit: build artifacts"
yarn check:build

echo "pre-commit: tests"
yarn test
