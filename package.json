{
  "name": "@noma4i/react-native-dblayer",
  "version": "10.0.0-beta.11",
  "description": "Reactive, persistent data-layer DSL for React Native with injectable storage and transport",
  "author": "Alexander Tsirel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noma4i/react-native-dblayer.git"
  },
  "homepage": "https://github.com/noma4i/react-native-dblayer#readme",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "check:build": "node scripts/check-build-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-jest-shards.mjs",
    "test:coverage": "node scripts/run-jest-shards.mjs --coverage",
    "test:mutation": "node scripts/run-mutation.mjs",
    "lint": "eslint .",
    "check:jsdoc": "node scripts/check-jsdoc.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "clean": "rm -rf lib",
    "prepare": "git config core.hooksPath .githooks",
    "test:mutation:full": "stryker run --force"
  },
  "peerDependencies": {
    "@graphql-typed-document-node/core": ">=3",
    "graphql": ">=16",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@babel/preset-env": "^7",
    "@graphql-typed-document-node/core": "^3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.10",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "graphql": "^16",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.0",
    "react-native-mmkv": "^4.3.2",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.9.2",
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@tanstack/db": "0.6.17",
    "@tanstack/pacer": "0.21.1",
    "@tanstack/react-query": "5.101.4",
    "es-toolkit": "^1.49.0"
  }
}
